APP_NAME="Airport Dispatcher"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:6030

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ---------------------------------------------------------------- Docker
# Must match your host user (`id -u` / `id -g`). Otherwise files created
# inside the container are owned by root and cannot be edited from the host.
WWWUSER=1001
WWWGROUP=1001

# Host port mappings. Ports 6000-6024 are already taken by other projects.
APP_PORT=6030
ME_PORT=6031
FORWARD_DB_PORT=6032
FORWARD_REDIS_PORT=6033
VITE_PORT=6034

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------- MongoDB
# DB_HOST is the compose service name, not localhost.
# authSource=admin is required: the root user lives in the `admin` database.
DB_CONNECTION=mongodb
DB_HOST=mongodb
DB_PORT=27017
DB_DATABASE=airport_dispatcher
DB_USERNAME=airport
DB_PASSWORD=secret
DB_URI="mongodb://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_DATABASE}?authSource=admin"

# mongo-express web UI, served on http://localhost:6031
ME_USERNAME=admin
ME_PASSWORD=admin

# ------------------------------------------------------- Session / Cache / Queue
# The `database` drivers are SQL-only and do not work on MongoDB.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --------------------------------------------------------------- Scheduler
# Cron expression for the flights:fetch command. The airport it collects is
# NOT configurable: it is hardcoded to EDDF (Frankfurt) for this proof of
# concept. Each run costs 60 OpenSky credits out of a 4000/day allowance, so
# hourly collection spends 1440 and today's board fills as the day goes on.
DISPATCH_CRON="0 * * * *"

# ----------------------------------------------------------- Gate allocation
# How long a flight holds a gate, and where that window sits relative to T
# (landing for an arrival, take-off for a departure). Set the departure offset
# to 0 to hold the gate after take-off instead of before it.
GATE_OCCUPANCY_MINUTES=90
GATE_OCCUPANCY_OFFSET_ARRIVAL_MINUTES=0
GATE_OCCUPANCY_OFFSET_DEPARTURE_MINUTES=-90

# The validator only checks allocations around now; finished ones are settled.
GATE_VALIDATE_GRACE_MINUTES=15
GATE_VALIDATE_HORIZON_MINUTES=90

DISPATCH_ALLOCATE_CRON="everyThirtySeconds"
DISPATCH_VALIDATE_CRON="everyThirtySeconds"
DISPATCH_REPORT_CRON="5 * * * *"

# ---------------------------------------------------------------- OpenSky
# Arrivals and departures require an OAuth2 client; anonymous requests are
# rejected with 403 "You cannot access historical flights". Create a client at
# https://opensky-network.org/ under My OpenSky > API clients.
# Without these the app falls back to clearly labelled demo traffic.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
